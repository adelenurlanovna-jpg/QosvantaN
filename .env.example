# ----- Supabase (required) -----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----- Anthropic Claude (required for /api/chat — AI consultant "Damir") -----
ANTHROPIC_API_KEY=sk-ant-api03-...

# ----- Telegram notifications (required for /api/contact, /api/match, /api/partners) -----
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ----- Google OAuth (configured in Supabase Auth → Providers; values only needed locally if using Supabase CLI) -----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ----- Gemini (optional — for the auto-scraper in scripts/scrape_processors.py) -----
GEMINI_API_KEY=
GEMINI_API_KEY_2=
