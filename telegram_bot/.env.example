# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Chat ID where applications will be sent (manager group/chat)
# To get chat ID: add @userinfobot to your group, it will show the ID
MANAGER_CHAT_ID=-100xxxxxxxxxx

# Optional: Bot name shown to users
BOT_NAME=PayMap Assistant
